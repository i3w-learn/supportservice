# Copy to .env and fill in. Never commit .env.
GOOGLE_CLOUD_PROJECT=ai-powered-479515
STORAGE_BUCKET=ai-powered-479515.firebasestorage.app

# Gupshup (Secret Manager in production)
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
# The app's UUID (shown as appId on any template in the list API). Needed to
# look up approved template ids.
GUPSHUP_APP_ID=
GUPSHUP_SOURCE_NUMBER=
WEBHOOK_SECRET=

# Cloud Tasks: background work (photo downloads, reminders).
# Tasks call back into this service at SERVICE_URL.
SERVICE_URL=https://support-service-537688366204.asia-south1.run.app
TASKS_QUEUE=support-tasks
TASKS_LOCATION=asia-south1

# Local only. Set these and firebase-admin talks to the emulator
# instead of real Firestore. `just test` sets them for you.
FIRESTORE_EMULATOR_HOST=localhost:8081
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
