# Copy to .env.local. These are public values, not secrets —
# the Firestore rules are what protect the data (design §9).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ai-powered-479515.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-powered-479515
VITE_FIREBASE_STORAGE_BUCKET=ai-powered-479515.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Point the dashboard at the local emulators instead of real Firestore.
VITE_USE_EMULATORS=true
