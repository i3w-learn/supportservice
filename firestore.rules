rules_version = '2';

// The dashboard reads Firestore straight from the browser, so the Firebase
// config in the bundle is public by design. This file is the only wall.
//
// "Signed in" is NOT a wall: Firebase Auth lets anyone in the world create an
// account in this project. Every read therefore checks membership in admins/.
// See §9 of support-system-design.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Every server write uses the Admin SDK, which bypasses these rules.
    // So client writes are denied everywhere, without exception.

    match /tickets/{ticketId} {
      allow read: if isAdmin();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /contacts/{waNumber} {
      allow read: if isAdmin();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // The ticket detail loads messages with a collection-group query across
    // every contacts/*/messages subcollection; that needs its own rule.
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /config/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-only. The allowlist itself is never client-readable.
    match /admins/{uid}    { allow read, write: if false; }
    match /inbound/{id}    { allow read, write: if false; }
    match /counters/{id}   { allow read, write: if false; }

    match /{document=**}   { allow read, write: if false; }
  }
}
